<?xml version="1.0" encoding="UTF-8"?>
<!--
  需要的 Info.plist 键。按需取用，不要整段替换原有 Info.plist。
  中文描述可以按项目语义改写，但必须存在，否则系统直接拒绝权限请求。
-->
<plist version="1.0">
<dict>

    <!-- ===== 静音音频保活必需 ===== -->
    <key>UIBackgroundModes</key>
    <array>
        <!-- 已有 audio 就保留；没有才加 -->
        <string>audio</string>
        <!-- 用定位保活才需要 -->
        <string>location</string>
    </array>

    <!-- ===== 定位保活必需 ===== -->
    <!-- iOS 13+ 用这条（推荐）；旧版用 NSLocationAlwaysUsageDescription -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>在后台维持运行需要持续定位权限；定位精度已降到最低，仅用于保持后台唤醒，不保存坐标。</string>

    <!-- 只在前台用定位时（如果只想要「使用期间」就不需要 Always 那条） -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Reads your location once when you approve a request from the app.</string>

    <!-- ===== BGTaskScheduler 必需 ===== -->
    <!-- 每个 identifier 必须和 KeepAliveTask.register(id:) 完全一致，区分大小写 -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.example.app.refresh</string>
    </array>

    <!-- ===== 环境探测必需 ===== -->
    <!-- 不加这个键，canOpenURL 永远返回 false，巨魔 / Sileo 就查不出来 -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>trollstore</string>
        <string>sileo</string>
        <string>cydia</string>
        <string>zbra</string>
        <string>apple-magnifier</string>
    </array>

    <!-- ===== 可选 ===== -->

    <!-- 如果需要「后台音频继续播放」，配合 audio mode 使用 -->
    <key>AVAudioSessionCategory</key>
    <string>AVAudioSessionCategoryPlayback</string>

    <!-- 想让老系统（iOS 14 的越狱设备）也能装，把最低版本降下来 -->
    <key>MinimumOSVersion</key>
    <string>14.0</string>

</dict>
</plist>
